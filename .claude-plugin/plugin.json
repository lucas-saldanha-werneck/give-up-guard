{
  "name": "give-up-guard",
  "version": "0.1.1",
  "description": "A Stop hook that sends Claude back to work when it ends a turn giving up, claiming something doesn't exist, asking you for data, or listing things as not checked, without having looked first.",
  "author": {
    "name": "Lucas Saldanha Werneck",
    "url": "https://github.com/lucas-saldanha-werneck"
  },
  "homepage": "https://github.com/lucas-saldanha-werneck/give-up-guard",
  "repository": "https://github.com/lucas-saldanha-werneck/give-up-guard",
  "license": "MIT",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/give_up_guard.py"], "timeout": 10 }
        ]
      }
    ]
  },
  "keywords": [
    "hooks",
    "stop-hook",
    "verification",
    "agent-behavior"
  ]
}
